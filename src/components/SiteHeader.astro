---
import { BOOKING_URL, NAV_LINKS } from './navLinks'

interface Props {
  current?: string
}

const { current } = Astro.props
---

<header class="sticky top-0 z-20 border-b border-bw-line bg-white px-6 py-4 md:px-14 md:py-[22px]">
  <div class="mx-auto max-w-site">
    <div class="flex items-center gap-4 md:gap-8">
      <a href="/" class="mr-auto block min-w-0">
        <img
          src="/assets/brightwing-logo.svg"
          alt="Brightwing Digital"
          width="224"
          height="26"
          class="block h-[22px] w-auto md:h-[25.5px]"
        />
      </a>
      <nav aria-label="Main" class="hidden gap-8 text-[14.5px] font-medium text-bw-ink-600 md:flex">
        {
          NAV_LINKS.map((link) => (
            <a
              href={link.href}
              aria-current={current === link.href ? 'page' : undefined}
              class:list={[
                'transition-colors',
                current === link.href ? 'font-semibold text-bw-ink-900' : 'hover:text-bw-ink-900',
              ]}
            >
              {link.label}
            </a>
          ))
        }
      </nav>
      <a
        href={BOOKING_URL}
        target="_blank"
        rel="noopener"
        class="rounded-md bg-bw-teal-600 px-4 py-[11px] text-[14.5px] font-semibold whitespace-nowrap text-white transition-colors hover:bg-bw-teal-700 md:px-6"
      >
        Book a call
      </a>
    </div>
    {/* Phones: the same links on their own row, so they stay visible without a menu toggle. */}
    <nav
      aria-label="Main"
      class="mt-3 flex justify-between text-[14px] font-medium text-bw-ink-600 md:hidden"
    >
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            aria-current={current === link.href ? 'page' : undefined}
            class={current === link.href ? 'font-semibold text-bw-ink-900' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
