---
import { BOOKING_URL } from '../components/navLinks'
import SiteFooter from '../components/SiteFooter.astro'
import SiteHeader from '../components/SiteHeader.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout
  title="Page not found — Brightwing Digital"
  description="This page doesn’t exist. Head back to the Brightwing Digital home page."
>
  <SiteHeader />

  {/* flex-1 fills the leftover height so the footer sits at the bottom of the window. */}
  <main class="flex-1 px-6 py-32 md:px-14">
    <div class="mx-auto max-w-site">
      <div class="mb-4 text-[11.5px] font-bold tracking-[3px] text-bw-teal-600 uppercase">404</div>
      <h1
        class="mb-6 font-serif text-5xl leading-[1.04] font-medium tracking-[-1px] md:text-[62px]"
      >
        We couldn’t find that page.
      </h1>
      <p class="mb-10 max-w-[520px] text-[17.5px] leading-[1.68] text-bw-ink-600">
        The link may be out of date, or the address may have a typo. Try the home page, or book a call
        if you were looking for us.
      </p>
      <div class="flex flex-wrap items-center gap-3.5">
        <a
          href="/"
          class="rounded-md bg-bw-teal-600 px-[30px] py-4 text-[15px] font-semibold text-white transition-colors hover:bg-bw-teal-700"
        >
          Go to the home page
        </a>
        <a
          href={BOOKING_URL}
          target="_blank"
          rel="noopener"
          class="rounded-md border border-bw-line-strong bg-white px-7 py-4 text-[15px] font-semibold text-bw-teal-600 transition-colors hover:text-bw-ink-900"
        >
          Book a call
        </a>
      </div>
    </div>
  </main>

  <SiteFooter />
</BaseLayout>
